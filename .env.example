GEMINI_API_KEY=
JARVIS_SCREEN_CAPTURE_ENABLED=true
JARVIS_MEMORY_ENABLED=true
# Pasta principal autorizada (padrão: diretório de execução)
# JARVIS_ALLOWED_DIR=C:\Users\SeuUsuario\Documents
# Pastas adicionais autorizadas, separadas por ';' (padrão: Área de Trabalho,
# Downloads e Documentos do usuário)
# JARVIS_ALLOWED_DIRS=C:\Users\SeuUsuario\Desktop;C:\Users\SeuUsuario\Downloads
# JARVIS_MEMORY_FILE=C:\Users\SeuUsuario\.jarvis\memory.json
# Modo de confirmação: graduated (padrão) | always | never
# JARVIS_CONFIRM_MODE=graduated
# Canal de confirmação: voice (padrão) | terminal
# JARVIS_CONFIRM_CHANNEL=voice
# Conversa contínua por voz (palavra de ativação): true | false
# JARVIS_WAKE_ENABLED=false
# JARVIS_WAKE_WORDS=jarvis,ei jarvis,hey jarvis
# JARVIS_HISTORY_MAX_MESSAGES=20
# JARVIS_COMMAND_TIMEOUT=30
# Modo de voz em tempo real (Gemini Live API): true | false
# JARVIS_LIVE_MODE=false
# Modelo Live (padrão: gemini-3.8-live)
# JARVIS_LIVE_MODEL=gemini-3.8-live
# Voz do modo Live (ex.: Puck, Charon, Kore, Fenrir, Aoede)
# JARVIS_LIVE_VOICE=Puck
# Taxas de amostragem do áudio (Hz)
# JARVIS_LIVE_INPUT_RATE=16000
# JARVIS_LIVE_OUTPUT_RATE=24000
# Voz (TTS): backend edge (padrão, vozes neurais naturais) ou gtts
# JARVIS_TTS_BACKEND=edge
# Voz do edge-tts. Ex.: pt-BR-AntonioNeural, pt-BR-FranciscaNeural, pt-BR-ThalitaNeural
# JARVIS_TTS_VOICE=pt-BR-AntonioNeural
# Velocidade e volume opcionais (ex.: +10%, -5%); vazio = padrão
# JARVIS_TTS_RATE=
# JARVIS_TTS_VOLUME=
# Modelo usado na pesquisa web (com grounding do Google)
# JARVIS_SEARCH_MODEL=gemini-2.5-flash
# Automação de navegador (Playwright). Requer: pip install playwright e
# 'playwright install chromium'. O Chrome instalado é usado quando possível.
# Canal do Chromium: chrome (padrão) | msedge | chromium | (vazio = bundle)
# JARVIS_BROWSER_CHANNEL=chrome
# Executar o navegador controlado sem interface: true | false
# JARVIS_BROWSER_HEADLESS=false
# Tempo limite das ações do navegador (ms)
# JARVIS_BROWSER_TIMEOUT_MS=30000
# Máximo de caracteres de texto lidos de uma página
# JARVIS_MAX_BROWSER_TEXT_CHARS=12000
# Gmail (OAuth): rode 'python gmail_setup.py' após criar o credentials.json
# JARVIS_GMAIL_CREDENTIALS=credentials.json
# JARVIS_GMAIL_TOKEN=
# JARVIS_GMAIL_MAX_RESULTS=10

# Interface Web (Dashboard)
# JARVIS_UI_HOST=127.0.0.1
# JARVIS_UI_PORT=8765
# Token opcional de autenticação para proteger o Dashboard e WebSocket (recomendado ao expor na rede)
# JARVIS_UI_TOKEN=sua-senha-ou-token-aqui

# Políticas/skills: pasta com arquivos .md que orientam o comportamento
# JARVIS_SKILLS_DIR=
# Quantas políticas e fatos injetar automaticamente no contexto
# JARVIS_MAX_CONTEXT_POLICIES=3
# JARVIS_MAX_CONTEXT_FACTS=8
# Perfil automático derivado da memória: true | false
# JARVIS_PERSONA_ENABLED=true

# Modo plano: o Jarvis apresenta um plano e só executa após a sua aprovação
# JARVIS_PLAN_MODE=false

# MCP (ferramentas externas). Requer 'pip install mcp' e um arquivo de config.
# JARVIS_MCP_ENABLED=true
# JARVIS_MCP_CONFIG=
# JARVIS_MCP_TIMEOUT=30

# Provedor de LLM: gemini (padrão) | openai | zen
# JARVIS_PROVIDER=gemini
# Endpoint compatível com a API da OpenAI (OpenAI, Ollama, LM Studio, ...)
# JARVIS_OPENAI_BASE_URL=https://api.openai.com/v1
# JARVIS_OPENAI_API_KEY=
# JARVIS_OPENAI_MODEL=gpt-4o-mini

# OpenCode Zen (LLMs gratuitas, endpoint compatível com a API da OpenAI).
# A chave é obtida de JARVIS_ZEN_API_KEY; se vazia, usa OPENCODE_API_KEY e,
# por fim, a própria credencial do OpenCode instalado (~/.local/share/opencode/auth.json).
# JARVIS_ZEN_BASE_URL=https://opencode.ai/inference/openai/v1
# JARVIS_ZEN_API_KEY=
# JARVIS_ZEN_MODEL=qwen3.6-plus-free

# Failover automático: cadeia de alvos na ordem de preferência (separados por
# vírgula). Cada alvo é "provedor" ou "provedor:modelo". Vazio = usa apenas
# JARVIS_PROVIDER (sem failover).
# JARVIS_PROVIDER_CHAIN=zen:qwen3.6-plus-free,zen:glm-5-free,gemini
# Segundos que um provedor fica fora da cadeia após um erro de cota (padrão: 21600 = 6h)
# JARVIS_FAILOVER_COOLDOWN=21600

# Interface: web (padrao) | compact (janela Tkinter + bandeja opcional)
# JARVIS_UI_MODE=web
# Respostas de ativacao variadas ("As suas ordens", "Pois nao"...): true | false
# JARVIS_WAKE_DYNAMIC=false
# Cria automaticamente um briefing diario as 08:00: true | false
# JARVIS_DAILY_BRIEFING_AUTO=false
# Chave do OpenWeather para o clima (opcional; ha fallback sem chave)
# OPENWEATHER_API_KEY=
